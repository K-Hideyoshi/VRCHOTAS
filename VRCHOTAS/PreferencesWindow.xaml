<Window x:Class="VRCHOTAS.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="640"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Hotkeys">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="Click an input box to capture a shortcut. Release the key or joystick button to confirm. Use Clear before assigning again." />

                    <TextBlock Grid.Row="1" Text="Cycle to previous configuration" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PreviousConfigBox"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Height="28"
                                 GotFocus="OnPreviousBoxGotFocus"
                                 LostFocus="OnCaptureBoxLostFocus"
                                 PreviewKeyDown="OnCapturePreviewKeyDown"
                                 PreviewKeyUp="OnPreviousBoxPreviewKeyUp" />
                        <Button Grid.Column="1" Content="Clear" Width="64" Click="OnClearPreviousClick" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Cycle to next configuration" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Grid.Row="4" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NextConfigBox"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Height="28"
                                 GotFocus="OnNextBoxGotFocus"
                                 LostFocus="OnCaptureBoxLostFocus"
                                 PreviewKeyDown="OnCapturePreviewKeyDown"
                                 PreviewKeyUp="OnNextBoxPreviewKeyUp" />
                        <Button Grid.Column="1" Content="Clear" Width="64" Click="OnClearNextClick" />
                    </Grid>

                    <TextBlock Grid.Row="5" Text="Toggle Master Switch (mapping on/off)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Grid.Row="6" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MasterSwitchBox"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Height="28"
                                 GotFocus="OnMasterBoxGotFocus"
                                 LostFocus="OnCaptureBoxLostFocus"
                                 PreviewKeyDown="OnCapturePreviewKeyDown"
                                 PreviewKeyUp="OnMasterBoxPreviewKeyUp" />
                        <Button Grid.Column="1" Content="Clear" Width="64" Click="OnClearMasterClick" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Euler Angles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Text="Choose how pitch, yaw, and roll are composed into the controller orientation." />

                        <GroupBox Header="Tait-Bryan Angles" Margin="0,0,0,12">
                            <StackPanel Margin="12,8">
                                <RadioButton x:Name="PitchYawRollRadio" GroupName="EulerOrder" Content="Pitch &#8594; Yaw &#8594; Roll (X &#8594; Y &#8594; Z)" Margin="0,0,0,6" />
                                <RadioButton x:Name="PitchRollYawRadio" GroupName="EulerOrder" Content="Pitch &#8594; Roll &#8594; Yaw (X &#8594; Z &#8594; Y)" Margin="0,0,0,6" />
                                <RadioButton x:Name="YawPitchRollRadio" GroupName="EulerOrder" Content="Yaw &#8594; Pitch &#8594; Roll (Y &#8594; X &#8594; Z)" Margin="0,0,0,6" />
                                <RadioButton x:Name="YawRollPitchRadio" GroupName="EulerOrder" Content="Yaw &#8594; Roll &#8594; Pitch (Y &#8594; Z &#8594; X)" Margin="0,0,0,6" />
                                <RadioButton x:Name="RollPitchYawRadio" GroupName="EulerOrder" Content="Roll &#8594; Pitch &#8594; Yaw (Z &#8594; X &#8594; Y)" Margin="0,0,0,6" />
                                <RadioButton x:Name="RollYawPitchRadio" GroupName="EulerOrder" Content="Roll &#8594; Yaw &#8594; Pitch (Z &#8594; Y &#8594; X)" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Axis reference frame">
                            <StackPanel Margin="12,8">
                                <RadioButton x:Name="LocalAxesRadio" GroupName="AxisReference" Content="Local axes (intrinsic rotations)" Margin="0,0,0,6" />
                                <RadioButton x:Name="WorldAxesRadio" GroupName="AxisReference" Content="World axes (extrinsic rotations)" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Controller Mode">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Text="Choose whether VRCHOTAS should provide both virtual controllers or leave one hand entirely to the native real controller in SteamVR." />

                        <GroupBox Header="Controller Mode">
                            <StackPanel Margin="12,8">
                                <RadioButton x:Name="FullVirtualModeRadio" GroupName="ControllerOutputMode" Content="Full Virtual" Margin="0,0,0,6" />
                                <RadioButton x:Name="HybridKeepLeftRealRadio" GroupName="ControllerOutputMode" Content="Left Real + Right Virtual" Margin="0,0,0,6" />
                                <RadioButton x:Name="HybridKeepRightRealRadio" GroupName="ControllerOutputMode" Content="Left Virtual + Right Real" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="VR Overlay">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Text="Configure the in-headset overlay used for Master Switch notifications, configuration switch toasts, and the optional persistent Master ON marker." />

                                <StackPanel Margin="12,8">
                                    <CheckBox x:Name="EnableVrOverlayCheckBox"
                                              Content="Enable VR overlay"
                                              Margin="0,0,0,10"
                                              Checked="OnVrOverlayEnabledChanged"
                                              Unchecked="OnVrOverlayEnabledChanged" />

                                    <CheckBox x:Name="HideWhenDashboardIsVisibleCheckBox"
                                              Content="Hide overlay when Steam Dashboard is active"
                                              Margin="0,0,0,12" />

                                    <StackPanel x:Name="VrOverlayOptionsPanel">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock Text="Overlay size" VerticalAlignment="Center" Width="150" />
                                            <Slider x:Name="OverlaySizeScaleSlider" Minimum="0.5" Maximum="3" TickFrequency="0.1" Width="180" IsSnapToTickEnabled="True" ValueChanged="OnOverlaySizeScaleChanged" />
                                            <TextBlock x:Name="OverlaySizeScaleValueLabel" Text="1.2" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                            <TextBlock Text="Distance from headset" VerticalAlignment="Center" Width="150" />
                                            <Slider x:Name="OverlayDistanceSlider" Minimum="0.2" Maximum="2" TickFrequency="0.1" Width="180" IsSnapToTickEnabled="True" ValueChanged="OnOverlayDistanceChanged" />
                                            <TextBlock x:Name="OverlayDistanceValueLabel" Text="0.8" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>

                                        <GroupBox Header="Toast settings" Margin="0,0,0,12">
                                            <StackPanel Margin="12,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                    <TextBlock Text="Duration (seconds)" VerticalAlignment="Center" Width="150" />
                                                    <Slider x:Name="VrOverlayToastDurationSlider" Minimum="0.5" Maximum="5" TickFrequency="0.1" Width="180" IsSnapToTickEnabled="True" ValueChanged="OnToastDurationChanged" />
                                                    <TextBlock x:Name="VrOverlayToastDurationValueLabel" Text="2.0" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                    <TextBlock Text="Vertical position" VerticalAlignment="Center" Width="150" />
                                                    <Slider x:Name="ToastPositionYSlider" Minimum="0" Maximum="1" TickFrequency="0.01" Width="180" IsSnapToTickEnabled="True" ValueChanged="OnToastPositionYChanged" />
                                                    <TextBlock x:Name="ToastPositionYValueLabel" Text="0.32" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                    <TextBlock Text="Text size" VerticalAlignment="Center" Width="150" />
                                                    <Slider x:Name="ToastTextSizeSlider" Minimum="15" Maximum="100" TickFrequency="1" Width="180" IsSnapToTickEnabled="True" ValueChanged="OnToastTextSizeChanged" />
                                                    <TextBlock x:Name="ToastTextSizeValueLabel" Text="32" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                    <TextBlock Text="Theme color" VerticalAlignment="Center" Width="150" />
                                                    <Button x:Name="ToastBgColorButton" Width="80" Height="24" Click="OnToastBgColorClick" Margin="0,0,8,0" />
                                                    <TextBlock x:Name="ToastBgColorLabel" VerticalAlignment="Center" Text="#80000000" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Opacity" VerticalAlignment="Center" Width="150" />
                                                    <Slider x:Name="ToastOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="180" ValueChanged="OnToastOpacityChanged" />
                                                    <TextBlock x:Name="ToastOpacityValueLabel" Text="0.75" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Master switch indicator">
                                            <StackPanel Margin="12,8">
                                                <CheckBox x:Name="ShowMasterStatusIndicatorCheckBox"
                                                          Content="Enable master switch indicator"
                                                          Margin="0,0,0,12" 
                                                          Checked="OnMasterIndicatorEnabledChanged"
                                                          Unchecked="OnMasterIndicatorEnabledChanged" />

                                                <StackPanel x:Name="MasterStatusIndicatorOptionsPanel">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,8">
                                                        <TextBlock Text="Image" VerticalAlignment="Center" Width="150" />
                                                        <!-- Image preview max 100px -->
                                                        <Image x:Name="MarkerImagePreview" MaxWidth="100" MaxHeight="100" Margin="0,0,8,0" HorizontalAlignment="Left" Stretch="Uniform" />
                                                        <Button Content="Browse..." Width="72" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnBrowseMarkerImage" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                        <TextBlock Text="Size" VerticalAlignment="Center" Width="150" />
                                                        <Slider x:Name="MarkerSizeSlider" Minimum="0" Maximum="20" TickFrequency="1" Width="180" ValueChanged="OnMarkerSizeChanged" IsSnapToTickEnabled="True" />
                                                        <TextBlock x:Name="MarkerSizeValueLabel" Text="5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                                        <TextBlock Text="Opacity" VerticalAlignment="Center" Width="150" />
                                                        <Slider x:Name="MarkerOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="180" ValueChanged="OnMarkerOpacityChanged" />
                                                        <TextBlock x:Name="MarkerOpacityValueLabel" Text="0.50" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="Position" VerticalAlignment="Top" Width="150" Margin="0,4,0,0" />
                                                        <StackPanel>
                                                            <Border Width="180" Height="180" BorderBrush="Gray" BorderThickness="1" Background="#11000000" 
                                                                    MouseLeftButtonDown="OnMarkerPositionPickerMouseDown"
                                                                    MouseMove="OnMarkerPositionPickerMouseMove"
                                                                    MouseLeftButtonUp="OnMarkerPositionPickerMouseLeftButtonUp">
                                                                <Canvas x:Name="MarkerPositionCanvas" Width="180" Height="180" Background="Transparent">
                                                                    <Line X1="0" Y1="90" X2="180" Y2="90" Stroke="#66000000" StrokeThickness="1" />
                                                                    <Line X1="90" Y1="0" X2="90" Y2="180" Stroke="#66000000" StrokeThickness="1" />
                                                                    <Ellipse x:Name="MarkerPositionIndicator" Width="12" Height="12" Fill="DodgerBlue" Stroke="Black" StrokeThickness="1" />
                                                                </Canvas>
                                                            </Border>
                                                            <TextBlock x:Name="MarkerPositionValueLabel" Margin="0,8,0,0" Text="X: 0.000  Y: 0.000" />

                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <Button Content="Reset to default"
                                                HorizontalAlignment="Right"
                                                Width="140"
                                                Margin="0,12,0,0"
                                                Click="OnResetVrOverlayDefaultsClick" />
                                    </StackPanel>
                                </StackPanel>
                        </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
            <Button Content="Apply" Width="88" Margin="0,0,8,0" Click="OnApplyClick" />
            <Button Content="Cancel" Width="88" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

