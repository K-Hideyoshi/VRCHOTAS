<Window x:Class="VRCHOTAS.PosePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pose Preview"
        Width="1100"
        Height="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"
                   Text="Current virtual controller pose preview" />

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="10,8"
                Background="#FFF8FAFC"
                BorderBrush="#FFD0D5DD"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock x:Name="PoseSourceText" FontWeight="SemiBold" />
                <TextBlock x:Name="EulerOrderText" Margin="0,4,0,0" />
                <TextBlock x:Name="AxisReferenceText" Margin="0,2,0,0" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="DimGray"
                           Text="Gray dashed lines show world axes. Colored lines show the controller's rotated local axes. Euler readout is derived from the quaternion for inspection only." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Left Controller">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               Foreground="DimGray"
                               Text="World: dashed gray, Local: X red / Y green / Z blue" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="260" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#FFFBFDFF"
                                BorderBrush="#FFD0D5DD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <Canvas x:Name="LeftAxesCanvas" Width="460" Height="230" Background="Transparent">
                                <Ellipse Width="10" Height="10" Fill="#FF111827" Canvas.Left="225" Canvas.Top="110" />

                                <Line x:Name="LeftWorldXAxis" Stroke="#FF98A2B3" StrokeThickness="2" StrokeDashArray="5,4" />
                                <Line x:Name="LeftWorldYAxis" Stroke="#FF98A2B3" StrokeThickness="2" StrokeDashArray="5,4" />
                                <Line x:Name="LeftWorldZAxis" Stroke="#FF98A2B3" StrokeThickness="2" StrokeDashArray="5,4" />

                                <Line x:Name="LeftLocalXAxis" Stroke="#FFDC2626" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line x:Name="LeftLocalYAxis" Stroke="#FF16A34A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line x:Name="LeftLocalZAxis" Stroke="#FF2563EB" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <Ellipse x:Name="LeftForwardMarker" Width="12" Height="12" Fill="#FF2563EB" Stroke="White" StrokeThickness="1.5" />
                                <TextBlock x:Name="LeftOrientationHint"
                                           Foreground="#FF344054"
                                           FontWeight="SemiBold" />
                            </Canvas>
                        </Border>

                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LeftPoseText"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Right Controller">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               Foreground="DimGray"
                               Text="World: dashed gray, Local: X red / Y green / Z blue" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="260" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#FFFBFDFF"
                                BorderBrush="#FFD0D5DD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <Canvas x:Name="RightAxesCanvas" Width="460" Height="230" Background="Transparent">
                                <Ellipse Width="10" Height="10" Fill="#FF111827" Canvas.Left="225" Canvas.Top="110" />

                                <Line x:Name="RightWorldXAxis" Stroke="#FF98A2B3" StrokeThickness="2" StrokeDashArray="5,4" />
                                <Line x:Name="RightWorldYAxis" Stroke="#FF98A2B3" StrokeThickness="2" StrokeDashArray="5,4" />
                                <Line x:Name="RightWorldZAxis" Stroke="#FF98A2B3" StrokeThickness="2" StrokeDashArray="5,4" />

                                <Line x:Name="RightLocalXAxis" Stroke="#FFDC2626" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line x:Name="RightLocalYAxis" Stroke="#FF16A34A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line x:Name="RightLocalZAxis" Stroke="#FF2563EB" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <Ellipse x:Name="RightForwardMarker" Width="12" Height="12" Fill="#FF2563EB" Stroke="White" StrokeThickness="1.5" />
                                <TextBlock x:Name="RightOrientationHint"
                                           Foreground="#FF344054"
                                           FontWeight="SemiBold" />
                            </Canvas>
                        </Border>

                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="RightPoseText"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>