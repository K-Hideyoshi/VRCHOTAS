<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icons\logo_bg_crop_outer.ico</ApplicationIcon>
    <AssemblyName>VRCHOTAS</AssemblyName>
    <Product>VRCHOTAS</Product>
    <Company>VRCHOTAS</Company>
    <Description>Transforms HOTAS and joystick devices into SteamVR controllers.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\artifacts\release\openvr-sdk-cache\sdk\headers\openvr_api.cs">
      <Link>Interop\openvr_api.cs</Link>
      <Nullable>disable</Nullable>
      <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625</NoWarn>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\artifacts\release\openvr-sdk-cache\sdk\bin\win64\openvr_api.dll">
      <Link>openvr_api.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildOverlayHelper" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <OverlayHelperProject>..\VRCHOTAS.OverlayHelper\VRCHOTAS.OverlayHelper.csproj</OverlayHelperProject>
      <OverlayHelperOutputDir>..\VRCHOTAS.OverlayHelper\bin\$(Configuration)\net10.0-windows</OverlayHelperOutputDir>
    </PropertyGroup>

    <MSBuild Projects="$(OverlayHelperProject)" Targets="Build" Properties="Configuration=$(Configuration)" />

    <ItemGroup>
      <OverlayHelperArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.exe" />
      <OverlayHelperArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.dll" />
      <OverlayHelperArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.deps.json" />
      <OverlayHelperArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.runtimeconfig.json" />
      <OverlayHelperArtifacts Include="$(OverlayHelperOutputDir)\openvr_api.dll" />
      <OverlayHelperArtifacts Include="$(OverlayHelperOutputDir)\Newtonsoft.Json.dll" />
      <FileWrites Include="@(OverlayHelperArtifacts->'$(OutDir)%(Filename)%(Extension)')" />
    </ItemGroup>

    <Copy SourceFiles="@(OverlayHelperArtifacts)"
          DestinationFiles="@(OverlayHelperArtifacts->'$(OutDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyOverlayHelperToPublishDirectory" AfterTargets="Publish">
    <PropertyGroup>
      <OverlayHelperOutputDir>..\VRCHOTAS.OverlayHelper\bin\$(Configuration)\net10.0-windows</OverlayHelperOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <OverlayHelperPublishArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.exe" />
      <OverlayHelperPublishArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.dll" />
      <OverlayHelperPublishArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.deps.json" />
      <OverlayHelperPublishArtifacts Include="$(OverlayHelperOutputDir)\VRCHOTAS.OverlayHelper.runtimeconfig.json" />
      <OverlayHelperPublishArtifacts Include="$(OverlayHelperOutputDir)\openvr_api.dll" />
      <OverlayHelperPublishArtifacts Include="$(OverlayHelperOutputDir)\Newtonsoft.Json.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(OverlayHelperPublishArtifacts)"
          DestinationFiles="@(OverlayHelperPublishArtifacts->'$(PublishDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="icons\*.ico" />
    <Resource Include="icons\*.png" />
  </ItemGroup>

</Project>
