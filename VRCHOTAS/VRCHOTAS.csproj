<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icons\logo_bg_crop_outer.ico</ApplicationIcon>
    <AssemblyName>VRCHOTAS</AssemblyName>
    <Product>VRCHOTAS</Product>
    <Company>VRCHOTAS</Company>
    <Description>Transforms HOTAS and joystick devices into SteamVR controllers.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <OpenVrHeaderPath>..\artifacts\release\openvr-sdk-cache\sdk\headers\openvr_api.cs</OpenVrHeaderPath>
    <OpenVrDllPath>..\artifacts\release\openvr-sdk-cache\sdk\bin\win64\openvr_api.dll</OpenVrDllPath>
  </PropertyGroup>

  <Target Name="ValidateOpenVrSdkCache" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(OpenVrHeaderPath)')" Text="OpenVR C# binding was not found at '$(OpenVrHeaderPath)'. Run scripts\publish-release.ps1 once or provide the OpenVR SDK cache before building VRCHOTAS." />
    <Error Condition="!Exists('$(OpenVrDllPath)')" Text="openvr_api.dll was not found at '$(OpenVrDllPath)'. Run scripts\publish-release.ps1 once or provide the OpenVR SDK cache before building VRCHOTAS." />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VRCHOTAS.OverlayHelper\VRCHOTAS.OverlayHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SetTargetFramework>TargetFramework=net10.0-windows</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy overlay helper outputs and dependencies to main app output directory -->
  <Target Name="CopyOverlayHelperOutputs" AfterTargets="Build">
    <PropertyGroup>
      <HelperOutputPath>..\VRCHOTAS.OverlayHelper\bin\$(Configuration)\net10.0-windows\win-x64\</HelperOutputPath>
      <HelperIconsPath>..\VRCHOTAS.OverlayHelper\icons\</HelperIconsPath>
    </PropertyGroup>

    <ItemGroup>
      <HelperFilesToCopy Include="$(HelperOutputPath)**\*.*" />
      <HelperIconFilesToCopy Include="$(HelperIconsPath)**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(HelperFilesToCopy)"
          DestinationFiles="@(HelperFilesToCopy->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

        <Copy SourceFiles="@(HelperIconFilesToCopy)"
          DestinationFiles="@(HelperIconFilesToCopy->'$(OutputPath)icons\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="high" Text="Copied overlay helper outputs from $(HelperOutputPath) to $(OutputPath)" />
        <Message Importance="high" Text="Copied overlay helper icons from $(HelperIconsPath) to $(OutputPath)icons\" />
  </Target>

  <!-- Copy overlay helper outputs to publish directory (dotnet publish does not
       automatically include files manually copied to OutputPath by custom targets) -->
  <Target Name="CopyOverlayHelperOutputsToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_OverlayHelperPublishSrc>..\VRCHOTAS.OverlayHelper\bin\$(Configuration)\net10.0-windows\win-x64\</_OverlayHelperPublishSrc>
    </PropertyGroup>

    <ItemGroup>
      <_OverlayHelperPublishFiles Include="$(_OverlayHelperPublishSrc)**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_OverlayHelperPublishFiles)"
          DestinationFiles="@(_OverlayHelperPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="high" Text="Copied overlay helper outputs to publish directory: $(PublishDir)" />
  </Target>

  <!-- Register helper files for clean -->
  <Target Name="RegisterHelperFilesForClean" BeforeTargets="Clean">
    <PropertyGroup>
      <HelperOutputPath>..\VRCHOTAS.OverlayHelper\bin\$(Configuration)\net10.0-windows\win-x64\</HelperOutputPath>
    </PropertyGroup>

    <ItemGroup>
      <HelperFilesToClean Include="$(OutputPath)VRCHOTAS.OverlayHelper.exe" />
      <HelperFilesToClean Include="$(OutputPath)VRCHOTAS.OverlayHelper.dll" />
      <HelperFilesToClean Include="$(OutputPath)VRCHOTAS.OverlayHelper.pdb" />
      <HelperFilesToClean Include="$(OutputPath)VRCHOTAS.OverlayHelper.deps.json" />
      <HelperFilesToClean Include="$(OutputPath)VRCHOTAS.OverlayHelper.runtimeconfig.json" />
      <HelperFilesToClean Include="$(OutputPath)SharpDX.dll" />
      <HelperFilesToClean Include="$(OutputPath)SharpDX.Direct3D11.dll" />
      <HelperFilesToClean Include="$(OutputPath)SharpDX.DXGI.dll" />
      <HelperFilesToClean Include="$(OutputPath)Newtonsoft.Json.dll" />
      <HelperFilesToClean Include="$(OutputPath)icons\**\*.*" />
    </ItemGroup>

    <Delete Files="@(HelperFilesToClean)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutputPath)icons" ContinueOnError="true" />
    <Message Importance="high" Text="Cleaned overlay helper outputs from $(OutputPath)" />
  </Target>

  <ItemGroup>
    <Compile Include="$(OpenVrHeaderPath)">
      <Link>Interop\openvr_api.cs</Link>
      <Nullable>disable</Nullable>
      <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625</NoWarn>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OpenVrDllPath)">
      <Link>openvr_api.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>





  <ItemGroup>
    <Resource Include="icons\*.ico" />
    <Resource Include="icons\*.png" />
  </ItemGroup>

</Project>
