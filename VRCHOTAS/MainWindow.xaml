<Window x:Class="VRCHOTAS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:VRCHOTAS.Converters"
         mc:Ignorable="d"
          Title="{Binding WindowTitle}" Height="760" Width="1320"
          Icon="icons/logo_bg_crop_outer.ico">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveConfigCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsConfigCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="NewConfigurationCommandExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:MappingSourceIndicatorConverter x:Key="MappingSourceIndicatorConverter" />
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFF6F7F9" />
            <Setter Property="BorderBrush" Value="#FFD0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEAECEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFDDE2E7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LocateMappingToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FFF6F7F9" />
            <Setter Property="BorderBrush" Value="#FFD0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEAECEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFDDE2E7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEAF2FF" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#FF2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MappingActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="MappingCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="#FF2563EB" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Foreground" Value="#FF111111" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MappingSourceGroupCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MappingCellStyle}">
            <Setter Property="Background" Value="{Binding SourceDuplicateBackground}" />
        </Style>
        <Style x:Key="MappingTargetGroupCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MappingCellStyle}">
            <Setter Property="Background" Value="{Binding TargetDuplicateBackground}" />
        </Style>
        <Style x:Key="MasterSwitchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF0F2F5" />
            <Setter Property="Foreground" Value="#FF1F2937" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFD0D5DD" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMappingEnabled}" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFE7F6EC" />
                                <Setter Property="BorderBrush" Value="#FFA7D7B5" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEAECEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFDDE2E7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Files">
                <MenuItem Header="New"
                          InputGestureText="Ctrl+N"
                          Command="{x:Static ApplicationCommands.New}" />
                <Separator />
                <MenuItem Header="Save" Command="{Binding SaveConfigCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save As..." Click="SaveAsConfigurationClick" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Show Configuration Folder" Click="RevealConfigFolderClick" />
                <MenuItem Header="Refresh Configuration List" Command="{Binding RefreshConfigListCommand}" />

                <MenuItem Header="Load Configuration">
                    <MenuItem.ItemsSource>
                        <Binding Path="LoadConfigurationMenuItems" />
                    </MenuItem.ItemsSource>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayFileName}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                            <Setter Property="Command" Value="{Binding DataContext.LoadConfigByNameCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding FileName}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

                <MenuItem Header="Set Default Configuration">
                    <MenuItem.ItemsSource>
                        <Binding Path="DefaultConfigurationMenuItems" />
                    </MenuItem.ItemsSource>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayFileName}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                            <Setter Property="Command" Value="{Binding DataContext.SetDefaultConfigByNameCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding FileName}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

                <Separator />
                <MenuItem Header="Preferences" Click="OnPreferencesMenuClick" />
                <Separator />
                <MenuItem Header="Exit" Click="ExitApplicationClick" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Log Window" Command="{Binding OpenLogWindowCommand}" />
                <MenuItem Header="Pose Preview" Click="OnPosePreviewMenuClick" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About VRCHOTAS" Click="OnAboutMenuClick" />
                <MenuItem Header="User Guide" Click="OnUserGuideMenuClick" />
                <MenuItem Header="Report Issue &amp; Advice" Click="OnReportIssueMenuClick" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Stretch" Margin="0,0,12,0">
                <TextBlock Text="Discovered Device" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding DeviceStatusSummary}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="12,0" VerticalAlignment="Stretch" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Driver Heartbeat:" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" Margin="0,0,12,0" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DriverHeartbeatStatusDisplay}" Foreground="{Binding DriverHeartbeatStatusBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sync Rate:" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DriverSyncRateDisplay}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Controller Mode:" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" Margin="0,0,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ControllerOutputModeDisplay}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Grid>

            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Button Style="{StaticResource MasterSwitchButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleMappingEnabledCommand}"
                        ToolTip="Mapping">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Width="20"
                               Height="20"
                               Margin="0,0,8,0"
                               Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/icons/toggle-line.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMappingEnabled}" Value="True">
                                            <Setter Property="Source" Value="pack://application:,,,/icons/toggle-fill.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding MappingEnabledStatusText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DeviceMonitorColumn" Width="400" />
                <ColumnDefinition Width="5.0*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="DeviceMonitorToggleButton"
                        Style="{StaticResource IconButtonStyle}"
                        Margin="0"
                        Click="DeviceMonitorToggleButtonClick"
                        ToolTip="Collapse or restore device monitor">
                    <Image x:Name="DeviceMonitorToggleIcon"
                           Width="18"
                           Height="18"
                           Stretch="Uniform"
                           Source="pack://application:,,,/icons/contract-left-line.png" />
                </Button>
            </StackPanel>

            <Grid x:Name="DeviceMonitorPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                <ScrollViewer x:Name="DeviceMonitorScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DeviceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding DeviceId}" FontStyle="Italic" FontSize="11" Margin="0,0,0,6" />

                                    <TextBlock Text="Axes"
                                               FontWeight="Bold"
                                               Margin="0,0,0,4"
                                               Visibility="{Binding HasAnyAxes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding HasPositionAxes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="0,0,0,8">
                                        <Border Width="100"
                                                Height="100"
                                                BorderBrush="Gray"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left"
                                                Background="#11000000">
                                            <Grid>
                                                <Line X1="50" Y1="0" X2="50" Y2="100" Stroke="#66000000" StrokeThickness="1" />
                                                <Line X1="0" Y1="50" X2="100" Y2="50" Stroke="#66000000" StrokeThickness="1" />
                                                <Canvas>
                                                    <Ellipse Width="12"
                                                             Height="12"
                                                             Fill="DodgerBlue"
                                                             Stroke="Black"
                                                              Canvas.Left="{Binding PositionIndicatorLeft}"
                                                              Canvas.Top="{Binding PositionIndicatorTop}" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding PositionDisplay}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Axes}"
                                                  Visibility="{Binding HasAxes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Value}" Height="18" Margin="8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat=F2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Buttons"
                                               FontWeight="Bold"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding HasButtons, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding Buttons}"
                                                  Visibility="{Binding HasButtons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <Ellipse Width="12" Height="12" Fill="{Binding IsPressed, Converter={StaticResource BooleanToBrushConverter}}" Stroke="Black" />
                                                    <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="POV"
                                               FontWeight="Bold"
                                               Margin="0,8,0,4"
                                               Visibility="{Binding HasPovs, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding Povs}"
                                                  Visibility="{Binding HasPovs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Border Grid.Column="1"
                                                            Width="72"
                                                            Height="72"
                                                            BorderBrush="Gray"
                                                            BorderThickness="1"
                                                            Background="#11000000"
                                                            ToolTip="{Binding Direction}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="4" Background="{Binding IsUp, Converter={StaticResource BooleanToBrushConverter}}" Margin="4">
                                                                <TextBlock Text="▲" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                                                            </Border>
                                                            <Border Grid.Row="1" Grid.Column="2" CornerRadius="4" Background="{Binding IsRight, Converter={StaticResource BooleanToBrushConverter}}" Margin="4">
                                                                <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                                                            </Border>
                                                            <Border Grid.Row="2" Grid.Column="1" CornerRadius="4" Background="{Binding IsDown, Converter={StaticResource BooleanToBrushConverter}}" Margin="4">
                                                                <TextBlock Text="▼" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                                                            </Border>
                                                            <Border Grid.Row="1" Grid.Column="0" CornerRadius="4" Background="{Binding IsLeft, Converter={StaticResource BooleanToBrushConverter}}" Margin="4">
                                                                <TextBlock Text="◀" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                                                            </Border>
                                                            <Ellipse Grid.Row="1"
                                                                     Grid.Column="1"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Fill="{Binding IsCentered, Converter={StaticResource BooleanToBrushConverter}}"
                                                                     Stroke="Black"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No physical inputs reported."
                                               Margin="0,4,0,0"
                                               FontStyle="Italic"
                                               Visibility="{Binding HasPhysicalInputs, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenAddMappingDialogCommand}" ToolTip="Add Mapping">
                        <Image Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/icons/file-add-line.png" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenEditMappingDialogCommand}" ToolTip="Edit Selected">
                        <Image Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/icons/file-edit-fill.png" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="0" Command="{Binding DeleteSelectedMappingCommand}" ToolTip="Delete Selected">
                        <Image Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/icons/delete-bin-line.png" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="4"
                        BorderBrush="#FFD0D5DD"
                        BorderThickness="1"
                        CornerRadius="10"
                        Background="#FFF8FAFC">
                    <ToggleButton Style="{StaticResource LocateMappingToggleButtonStyle}"
                                  IsChecked="{Binding IsLocateMappingEnabled, Mode=TwoWay}"
                                  ToolTip="Auto focus on activated mapping">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Source="pack://application:,,,/icons/focus-3-line.png"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocateMappingEnabled}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="LocateMappingSpinStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:1.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="LocateMappingSpinStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLocateMappingEnabled}" Value="False">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </StackPanel>
                    </ToggleButton>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1">
                <DataGrid x:Name="MappingsGrid"
                          ItemsSource="{Binding Mappings}"
                          SelectedItem="{Binding SelectedMapping}"
                          Tag="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AllowDrop="True"
                          Loaded="MappingsGridLoaded"
                          Sorting="MappingsGridSorting"
                          DragOver="MappingsGridDragOver"
                          DragLeave="MappingsGridDragLeave"
                          Drop="MappingsGridDrop">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <StaticResource ResourceKey="MappingCellStyle" />
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            IsEnabled="{Binding ElementName=MappingsGrid, Path=Tag}"
                                            PreviewMouseLeftButtonDown="MappingDragHandleMouseLeftButtonDown"
                                            PreviewMouseMove="MappingDragHandleMouseMove">
                                        <TextBlock Text="☰"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Drag to reorder">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF111111" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=MappingsGrid, Path=Tag}" Value="False">
                                                            <Setter Property="Foreground" Value="#FF98A2B3" />
                                                            <Setter Property="Opacity" Value="0.8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Cursor" Value="SizeAll" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=MappingsGrid, Path=Tag}" Value="False">
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="12"
                                             Height="12"
                                             Stroke="Black"
                                             StrokeThickness="0.8"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <MultiBinding Converter="{StaticResource MappingSourceIndicatorConverter}">
                                                <Binding Path="IsTemporarilyDisabled" />
                                                <Binding Path="IsSourceDeviceConnected" />
                                            </MultiBinding>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="SourceDeviceColumn" Header="Source Device" Binding="{Binding SourceDeviceName}" SortMemberPath="SourceDeviceName" Width="140">
                            <DataGridTextColumn.CellStyle>
                                <StaticResource ResourceKey="MappingSourceGroupCellStyle" />
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="SourceControlColumn" Header="Source Input" Binding="{Binding SourceControlDisplay}" SortMemberPath="SourceControlDisplay" Width="140">
                            <DataGridTextColumn.CellStyle>
                                <StaticResource ResourceKey="MappingSourceGroupCellStyle" />
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="TargetHandColumn" Header="Target Hand" Binding="{Binding TargetHand}" SortMemberPath="TargetHand" Width="90">
                            <DataGridTextColumn.CellStyle>
                                <StaticResource ResourceKey="MappingTargetGroupCellStyle" />
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="TargetControlColumn" Header="Target Input" Binding="{Binding TargetControlDisplay}" SortMemberPath="TargetControlDisplay" Width="170">
                            <DataGridTextColumn.CellStyle>
                                <StaticResource ResourceKey="MappingTargetGroupCellStyle" />
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="TypeColumn" Header="Mapping Type" Binding="{Binding MappingTypeDisplay}" SortMemberPath="MappingTypeDisplay" Width="Auto">
                            <DataGridTextColumn.CellStyle>
                                <StaticResource ResourceKey="MappingCellStyle" />
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn x:Name="DescriptionColumn" Header="Description" Width="220" CanUserSort="False" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellStyle>
                                <StaticResource ResourceKey="MappingCellStyle" />
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipOpening="DescriptionTextBlockToolTipOpening" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="154" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MappingActionButtonStyle}"
                                                ToolTip="Toggle"
                                                Command="{Binding DataContext.ToggleMappingTempDisabledCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Image Width="16"
                                                   Height="16"
                                                   Stretch="Uniform">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="pack://application:,,,/icons/toggle-fill.png" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTemporarilyDisabled}" Value="True">
                                                                <Setter Property="Source" Value="pack://application:,,,/icons/toggle-line.png" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Button>
                                        <Button Style="{StaticResource MappingActionButtonStyle}" ToolTip="Edit" Click="EditMappingClick">
                                            <Image Width="16" Height="16" Stretch="Uniform" Source="pack://application:,,,/icons/file-edit-fill.png" />
                                        </Button>
                                        <Button Style="{StaticResource MappingActionButtonStyle}" ToolTip="Copy" Click="CopyMappingClick">
                                            <Image Width="16" Height="16" Stretch="Uniform" Source="pack://application:,,,/icons/file-copy-2-fill.png" />
                                        </Button>
                                        <Button Style="{StaticResource MappingActionButtonStyle}" Margin="0" ToolTip="Delete" Click="DeleteMappingClick">
                                            <Image Width="16" Height="16" Stretch="Uniform" Source="pack://application:,,,/icons/delete-bin-line.png" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="MappingDropIndicator"
                            Height="3"
                            Background="DodgerBlue"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Panel.ZIndex="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
