<Window x:Class="VRCHOTAS.MappingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VRCHOTAS.Converters"
        Title="Mapping Editor"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12" Background="Transparent" MouseLeftButtonDown="RootGridMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="Source Detection" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,8"
                           Text="{Binding SourceDetectionInstruction}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" VerticalAlignment="Top" Text="Detected Source:" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding SourceSummary}"
                               TextWrapping="Wrap" />
                    <Button Width="90"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="Reset"
                            Click="ClearDetectionClick"
                            Visibility="{Binding HasDetectedSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Target" Margin="0,0,0,10" IsEnabled="{Binding CanEditTarget}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,6" Text="Target Type:" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"
                          ItemsSource="{Binding AvailableTargetKindOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Kind"
                          SelectedValue="{Binding SelectedTargetKind}" />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6" Text="Virtual Hand:" Visibility="{Binding ShowHandSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"
                          Visibility="{Binding ShowHandSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ItemsSource="{Binding HandTargets}" SelectedItem="{Binding TargetHand}" />

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,6" Text="VR Axis Target:" Visibility="{Binding ShowAxisPicker, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"
                          Visibility="{Binding ShowAxisPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                           ItemsSource="{Binding AxisTargetOptions}" DisplayMemberPath="Label" SelectedValuePath="Target" SelectedValue="{Binding TargetAxis}" />

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,6" Text="VR Button Target:" Visibility="{Binding ShowButtonPicker, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Grid.Row="3" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"
                          Visibility="{Binding ShowButtonPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                           ItemsSource="{Binding ButtonTargetOptions}" DisplayMemberPath="Label" SelectedValuePath="Target" SelectedValue="{Binding TargetButton}" />

                <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="0,0,0,6" Text="VR Pose Target:" Visibility="{Binding ShowControllerPosePicker, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Grid.Row="4" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"
                          Visibility="{Binding ShowControllerPosePicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ItemsSource="{Binding ControllerPoseTargetOptions}" DisplayMemberPath="Label" SelectedValuePath="Target" SelectedValue="{Binding TargetControllerPose}" />

                <TextBlock Grid.Row="5" VerticalAlignment="Center" Margin="0,0,0,6" Text="VR Pose Action:" Visibility="{Binding ShowAxisActionPicker, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Grid.Row="5" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,6"
                          Visibility="{Binding ShowAxisActionPicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ItemsSource="{Binding AxisActionTargetOptions}" DisplayMemberPath="Label" SelectedValuePath="Target" SelectedValue="{Binding TargetControllerPoseAction}" />

                <TextBlock Grid.Row="6" VerticalAlignment="Center" Margin="0,0,0,6" Text="Description:" />
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Margin="0,0,0,6"
                         VerticalContentAlignment="Center"
                         Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Keyboard Mapping" Margin="0,0,0,10"
                  Visibility="{Binding ShowKeyboardPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,6" Text="Target Key:" />
                <Button Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,6"
                        Content="{Binding KeyboardCaptureButtonText}"
                        Click="KeyboardCaptureClick" />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6" Text="Modifiers:" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox IsChecked="{Binding KeyboardModifierCtrl}" VerticalAlignment="Center" />
                    <TextBlock Margin="4,0,16,0" VerticalAlignment="Center" Text="Ctrl" />
                    <CheckBox IsChecked="{Binding KeyboardModifierShift}" VerticalAlignment="Center" />
                    <TextBlock Margin="4,0,16,0" VerticalAlignment="Center" Text="Shift" />
                    <CheckBox IsChecked="{Binding KeyboardModifierAlt}" VerticalAlignment="Center" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="Alt" />
                </StackPanel>

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,6" Text="Target Process:" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,6" FontStyle="Italic" Foreground="Gray" Text="(optional — window will be focused before sending keys)" />

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,6" Text="Process Name:" />
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             VerticalContentAlignment="Center"
                             Text="{Binding KeyboardTargetProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Width="80" Margin="6,0,0,0" Content="Select..." Click="SelectTargetWindowClick" />
                    <Button Grid.Column="2" Width="50" Margin="4,0,0,0" Content="Clear" Click="ClearTargetWindowClick" />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Grid.ColumnSpan="2" Header="Curves" Margin="0,0,0,10" Visibility="{Binding UsesAxisSource, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8" Text="Deadzone:" />
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="CurvePreviewWidthSourceSlider" Grid.Column="0" Minimum="0.0" Maximum="0.8" Value="{Binding Deadzone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                    <TextBox Grid.Column="1"
                             Margin="10,0,0,0"
                             Text="{Binding Deadzone, StringFormat=F3, Mode=OneWay}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right"
                             Tag="Deadzone"
                             GotKeyboardFocus="NumericValueEditorGotKeyboardFocus"
                             LostKeyboardFocus="NumericValueEditorLostFocus"
                             PreviewKeyDown="NumericValueEditorPreviewKeyDown" />
                </Grid>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,8" Text="Curve:" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="-1.0" Maximum="1.0" Value="{Binding Curve, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                    <TextBox Grid.Column="1"
                             Margin="10,0,0,0"
                             Text="{Binding Curve, StringFormat=F3, Mode=OneWay}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right"
                             Tag="Curve"
                             GotKeyboardFocus="NumericValueEditorGotKeyboardFocus"
                             LostKeyboardFocus="NumericValueEditorLostFocus"
                             PreviewKeyDown="NumericValueEditorPreviewKeyDown" />
                </Grid>

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,8" Text="Saturation:" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0.0" Maximum="{Binding SaturationSliderMaximum}" Value="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                    <TextBox Grid.Column="1"
                             Margin="10,0,0,0"
                             Text="{Binding Saturation, StringFormat=F3, Mode=OneWay}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right"
                             Tag="Saturation"
                             GotKeyboardFocus="NumericValueEditorGotKeyboardFocus"
                             LostKeyboardFocus="NumericValueEditorLostFocus"
                             PreviewKeyDown="NumericValueEditorPreviewKeyDown" />
                </Grid>

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,8" Text="Invert:" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding InputInvert}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,18,0" VerticalAlignment="Center" Text="Input" />
                    <CheckBox IsChecked="{Binding OutputInvert}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Output" />
                </StackPanel>

                <TextBlock Grid.Row="4" VerticalAlignment="Top" Margin="0,0,0,8" Text="Curve Preview:" />
                <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Width="{Binding ElementName=CurvePreviewWidthSourceSlider, Path=ActualWidth}"
                            Height="{Binding ElementName=CurvePreviewWidthSourceSlider, Path=ActualWidth}"
                            HorizontalAlignment="Left">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="200" Height="200" Margin="4">
                                <TextBlock Canvas.Left="2" Canvas.Top="2" Text="{Binding PlotYMaxLabel}" FontSize="10" Foreground="Gray" />
                                <TextBlock Canvas.Left="2" Canvas.Top="188" Text="{Binding PlotYMinLabel}" FontSize="10" Foreground="Gray" />
                                <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="Gray" StrokeThickness="1" />
                                <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="Gray" StrokeThickness="1" />
                                <Polyline Points="{Binding CurvePlotPoints}" Stroke="DeepSkyBlue" StrokeThickness="2" />

                                <Ellipse Width="12" Height="12" Fill="Red" Canvas.Left="{Binding CurrentInputPlotX}" Canvas.Top="{Binding CurrentInputPlotY}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-6" Y="-6" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Ellipse Width="6" Height="6" Fill="Yellow" Stroke="Black" StrokeThickness="0.6" Canvas.Left="{Binding CurrentOutputPlotX}" Canvas.Top="{Binding CurrentOutputPlotY}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-3" Y="-3" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Input:" />
                    <TextBlock VerticalAlignment="Center" Margin="6,0,12,0" Text="{Binding CurrentInputValue, StringFormat=F3}" />
                    <TextBlock VerticalAlignment="Center" Text="Mapped Output:" />
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Text="{Binding CurrentOutputValue, StringFormat=F3}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Header="State" Margin="0,0,0,10"
                  Visibility="{Binding ShowStatePanel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,6" Text="Toggle Mode:" Visibility="{Binding ShowToggleMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox Grid.Row="0" Grid.Column="1"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          IsChecked="{Binding ToggleMode}"
                          Visibility="{Binding ShowToggleMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6" Text="Full Press Threshold:" Visibility="{Binding ShowFullPressThreshold, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Visibility="{Binding ShowFullPressThreshold, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" Value="{Binding FullPressThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                    <TextBox Grid.Column="1"
                             Margin="10,0,0,0"
                             Text="{Binding FullPressThreshold, StringFormat=F2, Mode=OneWay}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right"
                             Tag="FullPressThreshold"
                             GotKeyboardFocus="NumericValueEditorGotKeyboardFocus"
                             LostKeyboardFocus="NumericValueEditorLostFocus"
                             PreviewKeyDown="NumericValueEditorPreviewKeyDown" />
                </Grid>

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,6" Text="Trigger Invert:" Visibility="{Binding ShowTriggerOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox Grid.Row="2" Grid.Column="1"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          IsChecked="{Binding TriggerInvert}"
                          Visibility="{Binding ShowTriggerOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,6" Text="Threshold Direction:" Visibility="{Binding ShowTriggerOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6"
                            Visibility="{Binding ShowTriggerOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <RadioButton GroupName="ThresholdDirection" IsChecked="{Binding ThresholdBidirectional}" Margin="0,0,12,0">
                        <TextBlock Text="Two-Way" />
                    </RadioButton>
                    <RadioButton GroupName="ThresholdDirection" IsChecked="{Binding ThresholdBidirectional, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="One-Way" />
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                            Visibility="{Binding IsSourceButtonDetected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <Grid Width="300" Height="28">
                        <ProgressBar Minimum="-1" Maximum="1" Value="{Binding SourceAxisValue, Mode=OneWay}" Height="18" VerticalAlignment="Center" />
                        <Canvas>
                            <Line X1="{Binding ThresholdLineLeft}" Y1="4" X2="{Binding ThresholdLineLeft}" Y2="24" Stroke="Red" StrokeThickness="1.5" StrokeDashArray="3,2"
                                  Visibility="{Binding ShowLeftThresholdLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Line X1="{Binding ThresholdLineRight}" Y1="4" X2="{Binding ThresholdLineRight}" Y2="24" Stroke="Red" StrokeThickness="1.5" StrokeDashArray="3,2" />
                        </Canvas>
                    </Grid>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Value: " />
                        <Run Text="{Binding AxisValueDisplay, Mode=OneWay}" />
                        <Run Text="  |  Threshold: " />
                        <Run Text="{Binding FullPressThreshold, StringFormat=F2}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6"
                            Visibility="{Binding IsSourceButtonDetected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Width="12" Height="12" Fill="{Binding SourceButtonPressed, Converter={StaticResource BooleanToBrushConverter}}" Stroke="Black" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding SourceButtonDisplay}" />
                </StackPanel>

                <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="0,0,0,6" Text="Source:" />

                <TextBlock Grid.Row="5" VerticalAlignment="Center" Margin="0,0,0,6" Text="Target Trigger:" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="12" Height="12" Fill="{Binding TargetTriggered, Converter={StaticResource BooleanToBrushConverter}}" Stroke="Black" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding TargetTriggerDisplay}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button Width="90" Margin="0,0,8,0" Content="Save" Click="SaveClick" />
            <Button Width="90" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
